# Used by api/_lib/geminiExtractor.ts to call Gemini's free tier for
# real AI extraction of gift descriptions (Version 2, Phase 2+).
#
# Get a free key (no credit card required) at https://aistudio.google.com
#
# If this is unset, api/parse-description.ts automatically falls back to
# the deterministic mock in src/utils/parseDescriptionMock.ts — the app
# still works without a key, just with lower-quality extraction.
#
# Server-side only. Never exposed to the browser, never committed —
# copy this file to .env.local and fill in your own key.
GEMINI_API_KEY=
